# --- Required ---
# Password for the single SIO workspace login.
SIO_ADMIN_PASSWORD=change-me
# Random string (32+ chars) used to sign session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Required for live research / AI generation ---
# Without this key, AI features show a setup error. Nothing is simulated.
ANTHROPIC_API_KEY=
# Web search must be enabled for your Anthropic organization (Console > Settings).

# --- Optional ---
# Default models per task (override in Settings screen). Strong model for reasoning/writing, lighter for extraction.
SIO_MODEL_REASONING=claude-sonnet-5-5
SIO_MODEL_EXTRACTION=claude-haiku-5-5
# SQLite file location
SIO_DB_PATH=./data/sio.db
